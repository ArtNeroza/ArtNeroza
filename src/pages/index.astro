    <header class="rise">
      <h1>Art C.&nbsp;<span class="mid">Neroza</span></h1>
      <p class="eyebrow" id="tagline">Full-Stack Developer &middot; HubSpot Administrator</p>
      <p class="blurb">
        I build scalable web applications from reusable components across the whole stack &mdash;
        <strong>Node.js</strong>, <strong>React.js</strong>, <strong>Next.js</strong>,
        <strong>Supabase</strong>, <strong>WordPress</strong>, <strong>PHP</strong>, <strong>Laravel</strong>, <strong>Angular</strong> and <strong>HubSpot</strong>
        &mdash; from La&nbsp;Union, Philippines.
      </p>

      <Kafra />
    </header>

    <nav class="work rise" aria-label="Demo projects">
      {featured.map((p) => <Card {...p} />)}
    </nav>

    <Rail />

    <footer class="foot rise">
      <p class="status"><span class="invite"><span class="dot" aria-hidden="true"></span>Bring ideas to life? Let&rsquo;s talk about it over coffee!<svg class="cup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g class="steam" stroke-width="2.1"><path d="M8.8 9c0-1.7 1.5-2.1 1.5-3.8S8.8 3.2 8.8 1.5"/><path d="M14.2 9c0-1.7 1.5-2.1 1.5-3.8s-1.5-2-1.5-3.7"/></g><g stroke-width="1.8"><path d="M4 11.5h12.5v4.2a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-4.2Z"/><path d="M16.5 13h1.3a2.4 2.4 0 0 1 0 4.8h-1.3"/><path d="M3.2 22.2h14"/></g></svg></span><a class="mail" href="mailto:art.neroza@gmail.com">art.neroza@gmail.com</a></p>

