---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

// ?url gives the fingerprinted _astro/ path so these can be preloaded
import fontArchivo from "../fonts/archivo-latin-var.woff2?url";
import fontSans from "../fonts/ibm-plex-sans-latin-var.woff2?url";
import fontMono400 from "../fonts/ibm-plex-mono-latin-400.woff2?url";
import fontMono500 from "../fonts/ibm-plex-mono-latin-500.woff2?url";
import fontMono700 from "../fonts/ibm-plex-mono-latin-700.woff2?url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Art C. Neroza — Full-Stack Developer & HubSpot Administrator",
  description = "Full-stack developer and HubSpot administrator in La Union, Philippines. I build web apps with Next.js, React, Supabase and WordPress. Open to remote work.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("og.png", Astro.site);

const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23181b21'/><text x='16' y='22' font-family='Georgia,serif' font-size='17' font-weight='700' fill='%23c0a469' text-anchor='middle'>A</text></svg>";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": new URL("#person", Astro.site).href,
  name: "Art C. Neroza",
  givenName: "Art",
  familyName: "Neroza",
  url: new URL("/", Astro.site).href,
  image: ogImage.href,
  email: "mailto:art.neroza@gmail.com",
  jobTitle: ["Full-Stack Developer", "HubSpot Administrator"],
  description:
    "Full-stack developer and HubSpot administrator building web applications with Next.js, React, Supabase, WordPress and HubSpot.",
  address: {
    "@type": "PostalAddress",
    addressLocality: "La Union",
    addressCountry: "PH",
  },
  knowsAbout: [
    "Next.js", "React.js", "Angular", "Vue.js", "Astro", "Node.js", "Express.js",
    "PHP", "Laravel", "WordPress", "Supabase", "PostgreSQL", "MongoDB", "AWS",
    "HubSpot CRM", "Headless CMS", "GraphQL", "Shopify",
    "Generative AI", "Claude Code", "ChatGPT", "Gemini",
  ],
  sameAs: [
    "https://www.linkedin.com/in/art-neroza/",
    "https://github.com/ArtNeroza",
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- runs before paint, so the page never flashes the wrong theme -->
<script is:inline>
  var G = { amber:"softened", moss:"standard", oxblood:"standard",
            dusk:"softened", petrol:"standard", seaglass:"softened" };
  var d = document.documentElement.dataset;
  try {
    d.theme  = localStorage.getItem("theme") || "light";
    d.accent = localStorage.getItem("accent") || "amber";
  } catch (e) { d.theme = "light"; d.accent = "amber"; }
  d.grounds = G[d.accent] || "softened";
</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="author" content="Art C. Neroza">

<meta property="og:type" content="website">
<meta property="og:site_name" content="Art C. Neroza">
<meta property="og:locale" content="en_US">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Art C. Neroza - Full-Stack Developer and HubSpot Administrator">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>

<meta name="theme-color" content="#f3efe7">

<!-- every face is used above the fold; preloading removes the swap reflow -->
<link rel="preload" href={fontArchivo} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fontSans} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fontMono400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fontMono500} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={fontMono700} as="font" type="font/woff2" crossorigin>
<link rel="icon" href={favicon}>
<script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
<Analytics />
</head>
<body>
  <slot />
</body>
</html>
