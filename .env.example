# Copy to .env and fill in. .env is gitignored; .env.example is not.
#
# Every secret here must also be declared in astro.config.mjs under env.schema.
# That is what keeps it out of the build: anything Astro doesn't know about can
# be swept into the import.meta.env snapshot that gets inlined into the server
# bundle. Add a variable to the schema in the same commit you add it here.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional but strongly recommended in production. Vercel KV or Upstash Redis —
# both publish these two names. Without them the chat rate limiter falls back to
# per-instance memory, which serverless resets on every cold start, so the daily
# model budget is not actually enforced.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Signs the assistant turns the browser sends back as history, so a
# visitor can't forge what Kafra "already said" and prime a jailbreak. Defaults
# to a hash of GEMINI_API_KEY, which works; set this to rotate the two apart.
CHAT_SECRET=
