---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Rail from "../components/Rail.astro";
import { featured } from "../data/projects";
---
<Base>
  <main>

    <header class="rise">
      <h1>Art C.&nbsp;<span class="mid">Neroza</span></h1>
      <p class="eyebrow">Full-Stack Developer &middot; HubSpot Administrator</p>
      <p class="blurb">
        I build scalable web applications from reusable components across the whole stack -
        <strong>Node.js</strong>, <strong>React.js</strong>, <strong>Next.js</strong>,
        <strong>Supabase</strong>, <strong>WordPress</strong>, <strong>PHP</strong>, <strong>Laravel</strong>, <strong>Angular</strong> and <strong>HubSpot</strong>
        - from La&nbsp;Union, Philippines.
      </p>
    </header>

    <nav class="work rise" aria-label="Demo projects">
      {featured.map((p) => <Card {...p} />)}
    </nav>

    <Rail />

    <footer class="foot rise">
      <div class="social">
        <a data-id="github" href="https://github.com/ArtNeroza" target="_blank" rel="noopener" aria-label="GitHub">
