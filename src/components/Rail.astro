---
import Card from "./Card.astro";
import { projects } from "../data/projects";

// Sorted here rather than in the browser so the default order is already right
// in the HTML: a no-JS visitor still gets A-Z, and there is no visible reshuffle
// once the script runs.
const az = [...projects].sort((a, b) => a.name.localeCompare(b.name));
---
<section class="projects rise" aria-labelledby="projects-label">
  <div class="rail-head">
    <h2 class="label" id="projects-label">Projects</h2>

    <div class="rail-tools">
      <div class="rail-sort" role="group" aria-label="Sort projects by name">
        <button class="rail-btn" type="button" data-sort="asc" aria-pressed="true" title="Sort A to Z" aria-label="Sort A to Z" aria-controls="rail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h5M4 12h9M4 17h13"/></svg></button>
        <button class="rail-btn" type="button" data-sort="desc" aria-pressed="false" title="Sort Z to A" aria-label="Sort Z to A" aria-controls="rail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h13M4 12h9M4 17h5"/></svg></button>
      </div>

      <div class="rail-nav">
        <button class="rail-btn" type="button" data-dir="-1" aria-label="Scroll to previous project" aria-controls="rail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
        <button class="rail-btn" type="button" data-dir="1" aria-label="Scroll to next project" aria-controls="rail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
      </div>
    </div>
  </div>

  <div class="rail" id="rail" tabindex="0" role="group" aria-labelledby="projects-label">
    {az.map((p) => <Card {...p} />)}
  </div>
</section>

<!-- is:inline keeps this in the document instead of emitting a separate 2 KB request -->
<script is:inline>
(function(){
  var rail = document.getElementById('rail');
  if(!rail) return;
  var btns  = document.querySelectorAll('.rail-nav .rail-btn');
  var sorts = document.querySelectorAll('[data-sort]');
  var calm  = matchMedia('(prefers-reduced-motion: reduce)');
  var DWELL = 5000, timer = null;

  function step(){
    var c = rail.firstElementChild;
    if(!c) return rail.clientWidth;
    var gap = parseFloat(getComputedStyle(rail).columnGap) || 0;
    return c.getBoundingClientRect().width + gap;
  }
  function maxScroll(){ return rail.scrollWidth - rail.clientWidth; }
  function overflows(){ return maxScroll() > 1; }

  function sync(){
    btns[0].disabled = !overflows() || rail.scrollLeft <= 1;
    btns[1].disabled = !overflows() || rail.scrollLeft >= maxScroll() - 1;
  }
  function go(dir){
    var to = rail.scrollLeft + step() * dir;
    if(dir > 0 && rail.scrollLeft >= maxScroll() - 1) to = 0;   // wrap at the end
    rail.scrollTo({left: to, behavior: 'smooth'});
  }

  function stop(){ clearInterval(timer); timer = null; }
  function play(){
    stop();
    if(calm.matches || !overflows()) return;                    // no motion, nothing to move
    timer = setInterval(function(){ go(1); }, DWELL);
  }

  btns.forEach(function(b){
    b.addEventListener('click', function(){ go(Number(b.dataset.dir)); play(); });
  });

  /* ---- sort ------------------------------------------------------
     Reorders the cards already in the DOM, so it costs no request and
     works off the name each card is actually showing. The markup ships
     A-Z, so this only ever has to handle a change away from that. */
  function label(card){
    var n = card.querySelector('.name');
    return (n ? n.textContent : '').trim();
  }
  function applySort(dir){
    Array.prototype.slice.call(rail.children)
      .sort(function(a, b){
        var c = label(a).localeCompare(label(b));
        return dir === 'desc' ? -c : c;
      })
      .forEach(function(card){ rail.appendChild(card); });   // re-append = reorder

    sorts.forEach(function(b){
      b.setAttribute('aria-pressed', String(b.dataset.sort === dir));
    });
    rail.scrollTo({left: 0, behavior: calm.matches ? 'auto' : 'smooth'});
    sync();
    play();
  }
  sorts.forEach(function(b){
    b.addEventListener('click', function(){ applySort(b.dataset.sort); });
  });

  // pause whenever a human is engaged with it, or the tab is hidden
  ['pointerenter','focusin','touchstart'].forEach(function(e){ rail.addEventListener(e, stop, {passive:true}); });
  ['pointerleave','focusout'].forEach(function(e){ rail.addEventListener(e, play, {passive:true}); });
  document.querySelector('.rail-tools').addEventListener('pointerenter', stop, {passive:true});
  document.querySelector('.rail-tools').addEventListener('pointerleave', play, {passive:true});
  document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : play(); });

  rail.addEventListener('scroll', sync, {passive:true});
  addEventListener('resize', function(){ sync(); play(); }, {passive:true});
  calm.addEventListener('change', play);

  sync(); play();
})();
</script>
