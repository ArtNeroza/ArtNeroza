      <div class="prefs">
        <p class="prefs-label">Your eyes matter!</p>
        <div class="prefs-row" role="group" aria-label="Appearance">
          <button type="button" data-theme-set="light" aria-label="Light theme" aria-pressed="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/></svg>
          </button>
          <button type="button" data-theme-set="dark" aria-label="Dark theme" aria-pressed="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
          </button>
          <span class="prefs-sep" aria-hidden="true"></span>
          <button type="button" class="swatch" data-accent-set="amber" aria-label="Low amber accent" aria-pressed="false"><span style="background:#c0a469"></span></button>
          <button type="button" class="swatch" data-accent-set="moss" aria-label="Moss accent" aria-pressed="false"><span style="background:#a8cb6b"></span></button>
          <button type="button" class="swatch" data-accent-set="oxblood" aria-label="Oxblood accent" aria-pressed="false"><span style="background:#ef8092"></span></button>
          <button type="button" class="swatch" data-accent-set="dusk" aria-label="Dusk blue accent" aria-pressed="false"><span style="background:#93aac9"></span></button>
          <button type="button" class="swatch" data-accent-set="petrol" aria-label="Petrol accent" aria-pressed="false"><span style="background:#79b6c9"></span></button>
          <button type="button" class="swatch" data-accent-set="seaglass" aria-label="Sea glass accent" aria-pressed="false"><span style="background:#7fb6ae"></span></button>
        </div>
      </div>
    </footer>

  </main>

<!-- Typewriter for the tagline. Progressive enhancement: the full string is
     already in the HTML above, so crawlers and no-JS visitors see it intact;
     this only takes over once it runs. -->
<script is:inline>
(function () {
  var el = document.getElementById("tagline");
  if (!el) return;

  var full = el.textContent.trim();
  var calm = matchMedia("(prefers-reduced-motion: reduce)");
  if (calm.matches || !full) return;          // leave the static text alone

  var sr = document.createElement("span");    // stable copy for screen readers
  sr.className = "sr-only";
  sr.textContent = full;

  var out = document.createElement("span");
  out.setAttribute("aria-hidden", "true");

  var caret = document.createElement("span");
  caret.className = "caret";
  caret.setAttribute("aria-hidden", "true");

  el.textContent = "";
  el.appendChild(sr);
  el.appendChild(out);
  el.appendChild(caret);

  var TYPE = 55, ERASE = 25, GAP = 500, CYCLE = 10000;
  var hold = Math.max(1200, CYCLE - full.length * (TYPE + ERASE) - GAP);
  var i = 0, dir = 1, t = null;

  // Reserve the finished height so typing can never reflow the page (CLS).
  function measure() {
    var prev = out.textContent;
    el.style.minHeight = "";
    out.textContent = full;
    var h = el.getBoundingClientRect().height;
    out.textContent = prev;
    el.style.minHeight = h + "px";
  }

  function tick() {
    i += dir;
    out.textContent = full.slice(0, i);
    if (dir > 0 && i >= full.length) { dir = -1; t = setTimeout(tick, hold); return; }
    if (dir < 0 && i <= 0)           { dir =  1; t = setTimeout(tick, GAP);  return; }
    t = setTimeout(tick, dir > 0 ? TYPE : ERASE);
  }

  function stop() { clearTimeout(t); t = null; }
  function play() { stop(); t = setTimeout(tick, GAP); }

  var rz;
  addEventListener("resize", function () {
    clearTimeout(rz);
    rz = setTimeout(measure, 150);
  }, { passive: true });

  document.addEventListener("visibilitychange", function () {
    document.hidden ? stop() : play();       // no timers in a background tab
  });

  calm.addEventListener("change", function () {
    if (calm.matches) { stop(); out.textContent = full; caret.remove(); }
  });

  measure();
  play();
})();
</script>

<script is:inline>
(function () {
  var root = document.documentElement;
  var btns = document.querySelectorAll("[data-theme-set]");
  var meta = document.querySelector('meta[name="theme-color"]');

  function apply(t) {
    root.dataset.theme = t;
    btns.forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.themeSet === t));
    });
    // keep the browser chrome in step with the page
    if (meta) {
      meta.setAttribute("content",
        getComputedStyle(root).getPropertyValue("--ground").trim() || "#f3efe7");
    }
  }

  btns.forEach(function (b) {
    b.addEventListener("click", function () {
      var t = b.dataset.themeSet;
      try { localStorage.setItem("theme", t); } catch (e) {}
      apply(t);
    });
  });

  // each accent ships with the ground set it was designed against
  var GROUNDS = { amber:"softened", moss:"standard", oxblood:"standard",
                  dusk:"softened", petrol:"standard", seaglass:"softened" };
  var swatches = document.querySelectorAll("[data-accent-set]");

  function applyAccent(a) {
    if (!GROUNDS[a]) a = "amber";
    root.dataset.accent = a;
    root.dataset.grounds = GROUNDS[a];
    swatches.forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.accentSet === a));
    });
    apply(root.dataset.theme || "light");   // grounds changed, so refresh theme-color
  }

  swatches.forEach(function (b) {
    b.addEventListener("click", function () {
      var a = b.dataset.accentSet;
      try { localStorage.setItem("accent", a); } catch (e) {}
      applyAccent(a);
    });
  });

  apply(root.dataset.theme || "light");
  applyAccent(root.dataset.accent || "amber");
})();
</script>
</Base>
